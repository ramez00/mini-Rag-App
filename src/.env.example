APP_NAME="mini-RAG"
APP_VERSION="0.1.0"
OPENAI_API_KEY="your_openai_api_key_here"

FILE_ALLOWED_EXTENSIONS=["text/plain","application/pdf"]
File_MAX_SIZE=10485760  # 10 MB in bytes
FILE_DEFAULT_CHUNK_SIZE=1000 

